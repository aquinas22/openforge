{
  "name": "openforge",
  "version": "1.0.0",
  "description": "Openforge — a Minecraft launcher for Windows 11 with CurseForge modpacks and offline play.",
  "author": "Noah Roe",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:portable": "electron-vite build && electron-builder --win portable --x64",
    "dist:linux": "electron-vite build && electron-builder --win --x64 -c.win.signAndEditExecutable=false",
    "dist:portable:linux": "electron-vite build && electron-builder --win portable --x64 -c.win.signAndEditExecutable=false",
    "release:windows:linux": "bash scripts/build-windows-linux.sh"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
